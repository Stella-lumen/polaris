// Reconstructed from Polaris client bundle (Prisma ScalarFieldEnum leaks)
// Types inferred from column names — verify before migrating

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AnnualAuditPlanPeriod {
  id String   @id @default(ulid())
  name String?
  description String?
  period_type String?
  status String? @default("OPEN")
  start_date DateTime?
  end_date DateTime?
  r_organization   Organization? @relation("organization", fields: [organization_id], references: [id])
  organization_id   String?
  disabled Boolean  @default(false)
  deleted Boolean  @default(false)
  created_by String?
  created_at DateTime?
  updated_by String?
  updated_at DateTime?
  deleted_by String?
  deleted_at DateTime?
  annualAuditPlans_period   AnnualAuditPlan[] @relation("period")
  @@map("annual_audit_plan_period")
}

model AnnualAuditPlan {
  id String   @id @default(ulid())
  name String?
  description String?
  r_period   AnnualAuditPlanPeriod? @relation("period", fields: [period_id], references: [id])
  period_id   String?
  r_prepared_by   User? @relation("prepared_by", fields: [prepared_by_id], references: [id])
  prepared_by_id   String?
  prepared_date DateTime?
  r_prepared_on_behalf_of   User? @relation("prepared_on_behalf", fields: [prepared_on_behalf_of_user_id], references: [id])
  prepared_on_behalf_of_user_id String?
  r_authorised_by   User? @relation("authorised_by", fields: [authorised_by_id], references: [id])
  authorised_by_id   String?
  authorised_date DateTime?
  status String? @default("DRAFT")
  committee_signed_by String?
  committee_signed_date DateTime?
  revision_reason String?
  version_no Int @default(1)
  r_organization   Organization? @relation("organization", fields: [organization_id], references: [id])
  organization_id   String?
  disabled Boolean  @default(false)
  deleted Boolean  @default(false)
  created_by String?
  created_at DateTime?
  updated_by String?
  updated_at DateTime?
  deleted_by String?
  deleted_at DateTime?
  plannedEngagements_annual_audit_plan   PlannedEngagement[] @relation("annual_audit_plan")
  engagements_annual_audit_plan   Engagement[] @relation("annual_audit_plan")
  @@map("annual_audit_plan")
}

// A controlled, time-limited arrangement: the delegate may prepare work
// in the given scope on the principal's behalf — but may never approve it.
model Delegation {
  id String   @id @default(ulid())
  r_delegate   User? @relation("delegation_delegate", fields: [delegate_user_id], references: [id])
  delegate_user_id String?
  r_principal   User? @relation("delegation_principal", fields: [principal_user_id], references: [id])
  principal_user_id String?
  scope_kind String?  // AUDIT_PLANS|WORKING_PAPERS|REPORTS|RISK_ASSESSMENTS|ENGAGEMENT
  r_engagement   Engagement? @relation("delegation_engagement", fields: [engagement_id], references: [id])
  engagement_id String?
  start_date DateTime?
  end_date DateTime?
  status String? @default("ACTIVE")  // ACTIVE|EXPIRED|REVOKED
  reason String?
  r_revoked_by   User? @relation("delegation_revoked_by", fields: [revoked_by_user_id], references: [id])
  revoked_by_user_id String?
  revoked_at DateTime?
  r_organization   Organization? @relation("organization", fields: [organization_id], references: [id])
  organization_id   String?
  disabled Boolean  @default(false)
  deleted Boolean  @default(false)
  created_by String?
  created_at DateTime?
  updated_by String?
  updated_at DateTime?
  deleted_by String?
  deleted_at DateTime?
  @@map("delegation")
}

