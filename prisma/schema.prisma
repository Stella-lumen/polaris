  setting_value String?
  organization_id   String?
  @@map("resource_setting")
}

// ---------- task scheduling ----------

model TaskDependency {
  id String   @id @default(ulid())
  task_id String?
  depends_on_task_id String?
  created_at DateTime?
  @@map("task_dependency")
}

model TaskTemplate {
  id String   @id @default(ulid())
  engagement_type_id String?
  stage String?
  title String?
  days_offset Int?   // days after engagement start
  default_role String?
  planned_hours Decimal?
  sort Int?
  organization_id   String?
  deleted Boolean  @default(false)
  created_at DateTime?
  @@map("task_template")
}

model TaskStage {
  id String   @id @default(ulid())
  name String?
  sort Int?
  organization_id   String?
  deleted Boolean  @default(false)
  @@map("task_stage")
}

model WorkingPaper {
  id String   @id @default(ulid())
  r_engagement   Engagement? @relation("working_papers", fields: [engagement_id], references: [id])
  engagement_id   String?
  reference String?
  title String?
  preparer_id String?
  prepared_date DateTime?
  reviewer_id String?
  reviewed_date DateTime?
  status String?   // PREPARED|REVIEWED|APPROVED|SENT_BACK
  review_comment String?
  finding_id String?
  template_id String?
  values_json Json?
  organization_id   String?
  disabled Boolean  @default(false)
  deleted Boolean  @default(false)
  created_by String?
  created_at DateTime?
  updated_by String?
  updated_at DateTime?
  @@map("working_paper")
}

model TemplateVersion {
  id String   @id @default(ulid())
  template_id String
  template_kind String?        // planning | report
  version Int?
  name String?
  description String?
  fields_json Json?
  changed_by String?
  created_at DateTime?
  approved_by String?
  approved_date DateTime?
  @@map("template_version")
}

model DocumentAcknowledgement {
  id String   @id @default(ulid())
  document_id String?
  user_id String?
  acked_at DateTime?
  @@map("document_acknowledgement")
}

model DocumentVersion {
  id String   @id @default(ulid())
  document_id String?
  version_no Int?
  file_id String?
  effective_date DateTime?
  review_date DateTime?
  approved_by String?
  approved_date DateTime?
  uploaded_by String?
  created_at DateTime?
  @@map("document_version")
}

model PlanVersion {
  id String   @id @default(ulid())
  plan_id String?
  version_no Int?
  snapshot Json?
  revised_by String?
  revision_reason String?
  created_at DateTime?
  @@map("plan_version")
}

model EmailSetting {
  id String   @id @default(ulid())
  mode String @default("DEMO")
  sender_name String?
  sender_email String?
  restrict_to_approved Boolean @default(true)
  redirect_all_to String?
  approved_addresses Json?
  last_run_at DateTime?
  updated_by String?
  updated_at DateTime?
  organization_id String?
  @@map("email_setting")
}
